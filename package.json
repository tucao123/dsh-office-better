{
  "name": "dsh-office-better",
  "version": "0.2.2",
  "description": "DSH Office 插件：确定性 PPT/DOCX/XLSX 生成 + IR 预览 + 数值化版式检查，零外部依赖",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "office",
    "pptx",
    "docx",
    "xlsx",
    "ooxml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tucao123/dsh-office-better.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/mount.mjs && node test/client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
